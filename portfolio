<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pixel Craft Web Design | Freelance Web Designer</title>
  <meta name="description" content="I design clean, mobile-friendly websites that bring your business more customers. Fast loading, responsive, and conversion-focused web design.">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="Pixel Craft Web Design | Freelance Web Designer">
  <meta property="og:description" content="I design clean, mobile-friendly websites that bring your business more customers.">
  <meta property="og:type" content="website">

  <!-- Favicon (Inline SVG Data URI) -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230b1220'/%3E%3Ccircle cx='11' cy='16' r='4' fill='%2300d2ff'/%3E%3Crect x='17' y='12' width='8' height='8' rx='2' fill='%2338bdf8'/%3E%3C/svg%3E">

  <!-- Google Fonts: Poppins (Headings) & Inter (Body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">

  <style>
    /* ==========================================================================
       CSS VARIABLES & THEME DEFINITIONS
       ========================================================================== */
    :root {
      /* Dark Theme (Default) */
      --bg-base: #0b1220;
      --bg-surface: #0f192d;
      --bg-card: #13223f;
      --bg-card-hover: #182a4d;
      --border-color: rgba(255, 255, 255, 0.09);
      --border-hover: rgba(0, 210, 255, 0.35);

      --accent: #00d2ff;
      --accent-hover: #38bdf8;
      --accent-glow: rgba(0, 210, 255, 0.18);
      --accent-gradient: linear-gradient(135deg, #00d2ff 0%, #0284c7 100%);

      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-soft: #64748b;

      --nav-bg: rgba(11, 18, 32, 0.88);
      --nav-border: rgba(255, 255, 255, 0.08);
      --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.25);
      --shadow-md: 0 12px 30px -8px rgba(0, 0, 0, 0.45);
      --shadow-lg: 0 20px 42px -10px rgba(0, 0, 0, 0.6);

      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;
      --transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-theme="light"] {
      --bg-base: #f8fafc;
      --bg-surface: #ffffff;
      --bg-card: #ffffff;
      --bg-card-hover: #f1f5f9;
      --border-color: #e2e8f0;
      --border-hover: rgba(2, 132, 199, 0.4);

      --accent: #0284c7;
      --accent-hover: #0369a1;
      --accent-glow: rgba(2, 132, 199, 0.15);
      --accent-gradient: linear-gradient(135deg, #0284c7 0%, #0ea5e9 100%);

      --text-main: #0b1220;
      --text-muted: #475569;
      --text-soft: #64748b;

      --nav-bg: rgba(248, 250, 252, 0.92);
      --nav-border: #e2e8f0;
      --shadow-sm: 0 4px 12px rgba(15, 23, 42, 0.05);
      --shadow-md: 0 12px 30px -8px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 20px 42px -10px rgba(15, 23, 42, 0.12);
    }

    /* ==========================================================================
       BASE & RESET STYLES
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-base);
      color: var(--text-main);
      line-height: 1.65;
      overflow-x: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, .font-heading {
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.25;
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: var(--transition);
    }

    button, input, textarea {
      font-family: inherit;
      font-size: 1rem;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    .container {
      width: 100%;
      max-width: 1160px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    section {
      padding: 5.5rem 0;
      position: relative;
    }

    /* Section Headers */
    .section-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 3.5rem auto;
    }

    .section-title {
      font-size: clamp(1.85rem, 3.5vw, 2.45rem);
      margin-bottom: 0.85rem;
      letter-spacing: -0.02em;
    }

    .section-subtitle {
      color: var(--text-muted);
      font-size: 1.05rem;
    }

    .section-note {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-top: 0.65rem;
      line-height: 1.5;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.85rem 1.65rem;
      border-radius: var(--radius-full);
      font-weight: 600;
      font-size: 0.95rem;
      transition: var(--transition);
      text-align: center;
      white-space: nowrap;
    }

    .btn-primary {
      background: var(--accent-gradient);
      color: #04101e;
      box-shadow: 0 4px 18px var(--accent-glow);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px var(--accent-glow);
      filter: brightness(1.08);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-color);
      color: var(--text-main);
    }

    [data-theme="light"] .btn-secondary {
      background: #f1f5f9;
      border-color: #cbd5e1;
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }

    .btn-whatsapp {
      background-color: #25d366;
      color: #ffffff;
      box-shadow: 0 4px 16px rgba(37, 211, 102, 0.3);
    }

    .btn-whatsapp:hover {
      background-color: #20ba59;
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(37, 211, 102, 0.4);
    }

    /* Scroll Animation Utility */
    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       1. NAVBAR
       ========================================================================== */
    .navbar {
      position: sticky;
      top: 0;
      left: 0;
      width: 100%;
      background: var(--nav-bg);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      z-index: 1000;
      border-bottom: 1px solid var(--nav-border);
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 74px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 1.25rem;
      color: var(--text-main);
      letter-spacing: -0.01em;
    }

    .logo-badge {
      width: 38px;
      height: 38px;
      background: var(--accent-gradient);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #04101e;
      font-weight: 800;
      font-size: 1.05rem;
    }

    .logo span {
      color: var(--accent);
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 1.85rem;
      list-style: none;
    }

    .nav-link {
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--text-muted);
      position: relative;
      padding: 0.35rem 0;
    }

    .nav-link:hover {
      color: var(--accent);
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0%;
      height: 2px;
      background-color: var(--accent);
      transition: width 0.25s ease;
    }

    .nav-link:hover::after {
      width: 100%;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    /* Light/Dark Toggle */
    .theme-toggle {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      border: 1px solid var(--border-color);
      transition: var(--transition);
    }

    .theme-toggle:hover {
      color: var(--accent);
      border-color: var(--accent);
    }

    .theme-toggle svg {
      width: 19px;
      height: 19px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
    }

    .theme-toggle .moon-icon { display: none; }
    [data-theme="light"] .theme-toggle .sun-icon { display: none; }
    [data-theme="light"] .theme-toggle .moon-icon { display: block; }

    /* Mobile Hamburger */
    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 30px;
      height: 20px;
      padding: 0;
      z-index: 1001;
    }

    .hamburger span {
      width: 100%;
      height: 2px;
      background: var(--text-main);
      border-radius: 2px;
      transition: var(--transition);
    }

    .hamburger.open span:nth-child(1) {
      transform: translateY(9px) rotate(45deg);
    }
    .hamburger.open span:nth-child(2) {
      opacity: 0;
    }
    .hamburger.open span:nth-child(3) {
      transform: translateY(-9px) rotate(-45deg);
    }

    /* ==========================================================================
       2. HERO SECTION
       ========================================================================== */
    .hero-section {
      padding: 6.5rem 0 5rem;
      background: radial-gradient(circle at 50% 15%, rgba(0, 210, 255, 0.08) 0%, transparent 60%);
      text-align: center;
    }

    .hero-content {
      max-width: 820px;
      margin: 0 auto;
    }

    .hero-headline {
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      letter-spacing: -0.03em;
      margin-bottom: 1.4rem;
      line-height: 1.18;
    }

    .hero-headline .highlight {
      background: var(--accent-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtext {
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      color: var(--text-muted);
      margin-bottom: 2.2rem;
      max-width: 650px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 3.5rem;
    }

    .trust-badges {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 1.5rem 2.2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border-color);
    }

    .badge-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.92rem;
      font-weight: 500;
      color: var(--text-muted);
    }

    .badge-item svg {
      width: 20px;
      height: 20px;
      color: var(--accent);
      flex-shrink: 0;
    }

    /* ==========================================================================
       3. PROJECTS SECTION & BROWSER MOCKUP
       ========================================================================== */
    .projects-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .project-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      box-shadow: var(--shadow-md);
      transition: var(--transition);
    }

    .project-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
    }

    /* Browser Mockup Window */
    .project-preview {
      display: flex;
      flex-direction: column;
      background: #060d19;
      border-right: 1px solid var(--border-color);
      overflow: hidden;
    }

    .browser-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.65rem 1rem;
      background: rgba(0, 0, 0, 0.4);
      border-bottom: 1px solid var(--border-color);
    }

    [data-theme="light"] .browser-bar {
      background: #e2e8f0;
    }

    .browser-dots {
      display: flex;
      gap: 5px;
    }

    .browser-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
    }

    .dot-red { background: #ef4444; }
    .dot-yellow { background: #f59e0b; }
    .dot-green { background: #10b981; }

    .browser-url {
      font-family: monospace;
      font-size: 0.75rem;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.05);
      padding: 0.2rem 0.65rem;
      border-radius: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
    }

    [data-theme="light"] .browser-url {
      background: #ffffff;
      color: #475569;
    }

    .project-image-wrap {
      position: relative;
      overflow: hidden;
      height: 100%;
      min-height: 290px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #081122;
    }

    .project-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.4s ease;
    }

    .project-card:hover .project-image-wrap img {
      transform: scale(1.03);
    }

    .project-fallback {
      width: 100%;
      height: 100%;
      min-height: 290px;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      background: linear-gradient(135deg, #0e1e38 0%, #152c52 100%);
      color: #94a3b8;
      padding: 2rem;
      text-align: center;
    }

    .project-details {
      padding: 2.2rem;
      display: flex;
      flex-direction: column;
    }

    .project-category {
      display: inline-block;
      align-self: flex-start;
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent);
      background: var(--accent-glow);
      padding: 0.3rem 0.8rem;
      border-radius: var(--radius-full);
      margin-bottom: 0.8rem;
    }

    .project-title {
      font-size: 1.5rem;
      margin-bottom: 0.8rem;
    }

    .project-description {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 1.25rem;
    }

    .project-subheading {
      font-weight: 600;
      font-size: 0.88rem;
      color: var(--text-main);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.6rem;
    }

    .project-features {
      list-style: none;
      margin-bottom: 1.8rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    .project-features li {
      font-size: 0.88rem;
      color: var(--text-muted);
      position: relative;
      padding-left: 1.4rem;
      line-height: 1.45;
    }

    .project-features li::before {
      content: '✓';
      position: absolute;
      left: 0;
      top: 0;
      color: var(--accent);
      font-weight: 700;
    }

    .project-card .btn {
      align-self: flex-start;
      margin-top: auto;
    }

    /* ==========================================================================
       4. SERVICES SECTION
       ========================================================================== */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
    }

    .service-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 2.2rem 1.8rem;
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .service-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
    }

    .service-icon {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      background: var(--accent-glow);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.35rem;
    }

    .service-icon svg {
      width: 25px;
      height: 25px;
    }

    .service-title {
      font-size: 1.25rem;
      margin-bottom: 0.6rem;
    }

    .service-text {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .services-note {
      text-align: center;
      margin-top: 2.5rem;
      color: var(--text-muted);
      font-size: 0.95rem;
      font-style: italic;
    }

    /* ==========================================================================
       5. PROCESS SECTION
       ========================================================================== */
    .process-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .process-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 2.5rem 1.8rem;
      transition: var(--transition);
      position: relative;
    }

    .process-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-4px);
    }

    .process-number {
      font-family: 'Poppins', sans-serif;
      font-size: 2.7rem;
      font-weight: 800;
      color: var(--accent);
      opacity: 0.4;
      line-height: 1;
      margin-bottom: 1rem;
    }

    .process-title {
      font-size: 1.35rem;
      margin-bottom: 0.75rem;
    }

    .process-text {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* ==========================================================================
       6. ABOUT ME SECTION
       ========================================================================== */
    .about-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 3.5rem 2.5rem;
      max-width: 860px;
      margin: 0 auto;
      text-align: center;
      box-shadow: var(--shadow-md);
    }

    .avatar-circle {
      width: 100px;
      height: 100px;
      border-radius: var(--radius-full);
      background: var(--accent-gradient);
      color: #04101e;
      font-family: 'Poppins', sans-serif;
      font-size: 2.2rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.8rem auto;
      box-shadow: 0 8px 24px var(--accent-glow);
    }

    .about-bio {
      font-size: clamp(1.15rem, 2.5vw, 1.4rem);
      line-height: 1.6;
      font-weight: 500;
      margin-bottom: 2.4rem;
      color: var(--text-main);
    }

    .strengths-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    .strength-tag {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-color);
      padding: 0.6rem 1.35rem;
      border-radius: var(--radius-full);
      font-weight: 600;
      font-size: 0.92rem;
      color: var(--text-main);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    [data-theme="light"] .strength-tag {
      background: #f1f5f9;
    }

    .strength-tag svg {
      width: 16px;
      height: 16px;
      color: var(--accent);
    }

    /* ==========================================================================
       7. CONTACT SECTION
       ========================================================================== */
    .contact-layout {
      display: grid;
      grid-template-columns: 1fr 1.25fr;
      gap: 2.5rem;
      align-items: start;
    }

    .contact-channels {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .contact-channel-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1.35rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.2rem;
      transition: var(--transition);
    }

    .contact-channel-card:hover {
      border-color: var(--border-hover);
      transform: translateX(4px);
    }

    .channel-icon {
      width: 46px;
      height: 46px;
      border-radius: 10px;
      background: var(--accent-glow);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .channel-icon svg {
      width: 22px;
      height: 22px;
    }

    .channel-info {
      overflow: hidden;
    }

    .channel-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.15rem;
    }

    .channel-value {
      font-weight: 600;
      font-size: 0.98rem;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Contact Form */
    .contact-form-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 2.4rem;
      box-shadow: var(--shadow-md);
    }

    .form-group {
      margin-bottom: 1.35rem;
    }

    .form-label {
      display: block;
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 0.45rem;
      color: var(--text-main);
    }

    .form-control {
      width: 100%;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1rem;
      color: var(--text-main);
      transition: var(--transition);
    }

    [data-theme="light"] .form-control {
      background: #f8fafc;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    textarea.form-control {
      resize: vertical;
      min-height: 125px;
    }

    .form-alert {
      padding: 0.75rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.88rem;
      margin-top: 1rem;
      display: none;
    }

    .form-alert.error {
      display: block;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #ef4444;
    }

    .form-alert.success {
      display: block;
      background: rgba(34, 197, 94, 0.15);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #22c55e;
    }

    /* ==========================================================================
       8. FOOTER
       ========================================================================== */
    .footer {
      background-color: var(--bg-surface);
      border-top: 1px solid var(--border-color);
      padding: 4rem 0 2rem;
    }

    .footer-top {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 3.5rem;
    }

    .footer-brand p {
      color: var(--text-muted);
      margin-top: 0.9rem;
      max-width: 320px;
      font-size: 0.92rem;
    }

    .footer-column h4 {
      font-size: 1rem;
      margin-bottom: 1.2rem;
      color: var(--text-main);
    }

    .footer-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .footer-links a {
      color: var(--text-muted);
      font-size: 0.92rem;
    }

    .footer-links a:hover {
      color: var(--accent);
      padding-left: 4px;
    }

    .footer-bottom {
      border-top: 1px solid var(--border-color);
      padding-top: 2rem;
      text-align: center;
      color: var(--text-soft);
      font-size: 0.88rem;
    }

    /* ==========================================================================
       FLOATING ACTION BUTTONS
       ========================================================================== */
    .floating-whatsapp {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      width: 58px;
      height: 58px;
      border-radius: var(--radius-full);
      background-color: #25d366;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
      z-index: 999;
      transition: var(--transition);
    }

    .floating-whatsapp:hover {
      transform: scale(1.08) translateY(-2px);
      box-shadow: 0 10px 25px rgba(37, 211, 102, 0.6);
    }

    .floating-whatsapp svg {
      width: 32px;
      height: 32px;
      fill: currentColor;
    }

    .back-to-top {
      position: fixed;
      bottom: 6.2rem;
      right: 2.3rem;
      width: 44px;
      height: 44px;
      border-radius: var(--radius-full);
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-sm);
      z-index: 998;
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px);
      transition: var(--transition);
    }

    .back-to-top.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .back-to-top:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-3px);
    }

    .back-to-top svg {
      width: 20px;
      height: 20px;
    }

    /* ==========================================================================
       RESPONSIVE DESIGN (MEDIA QUERIES)
       ========================================================================== */
    @media (max-width: 992px) {
      .project-card {
        grid-template-columns: 1fr;
      }

      .project-preview {
        border-right: none;
        border-bottom: 1px solid var(--border-color);
      }

      .project-image-wrap {
        height: 260px;
      }

      .process-grid {
        grid-template-columns: 1fr;
      }

      .contact-layout {
        grid-template-columns: 1fr;
      }

      .footer-top {
        grid-template-columns: 1fr;
        gap: 2.2rem;
      }
    }

    @media (max-width: 768px) {
      section {
        padding: 4rem 0;
      }

